                btn.className = "tab-btn whitespace-nowrap px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-400 hover:bg-slate-700 hover:text-slate-200 transition-all";
            });

            // 클릭된 버튼 스타일 적용 (모던 인디고 탭)
            const activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.className = "tab-btn whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-md shadow-indigo-600/30 transition-all";

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleAnswer(id) {
            const el = document.getElementById(id);
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden');
            } else {
                el.classList.add('hidden');
            }
        }
    </script>
</body>
</html>
